{
  "title": "LuxeCart Reconciliation",
  "uid": "luxecart-recon",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Reconciliation Runs",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(reconciliation_runs_total)",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Latest Match Rate (%)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(reconciliation_match_rate)",
          "legendFormat": "Match Rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizValue": 0,
        "maxVizValue": 100,
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "green", "value": 90 }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Settlement Records Ingested",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(settlement_records_ingested_total)",
          "legendFormat": "Records"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Parse Errors",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(settlement_parse_errors_total)",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Duration (p95)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transactions Imported",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(transactions_imported_total[5m])",
          "legendFormat": "Import rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Settlement Records by PSP",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "settlement_records_ingested_total",
          "legendFormat": "{{psp_name}}"
        }
      ]
    }
  ]
}
